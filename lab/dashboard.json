{
  "displayName": "Orders API Observability",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "width": 6, "height": 4,
        "widget": {
          "title": "Requests by response class (native)",
          "xyChart": {
            "dataSets": [{
              "plotType": "STACKED_BAR",
              "timeSeriesQuery": {"timeSeriesFilter": {
                "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"orders-api\"",
                "aggregation": {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM", "groupByFields": ["metric.label.\"response_code_class\""]}
              }}
            }]
          }
        }
      },
      {
        "xPos": 6, "width": 6, "height": 4,
        "widget": {
          "title": "Platform latency p50/p95/p99 (native)",
          "xyChart": {
            "dataSets": [
              {"plotType": "LINE", "legendTemplate": "p50", "timeSeriesQuery": {"timeSeriesFilter": {"filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"orders-api\"", "aggregation": {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_PERCENTILE_50", "crossSeriesReducer": "REDUCE_MEAN"}}}},
              {"plotType": "LINE", "legendTemplate": "p95", "timeSeriesQuery": {"timeSeriesFilter": {"filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"orders-api\"", "aggregation": {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_PERCENTILE_95", "crossSeriesReducer": "REDUCE_MEAN"}}}},
              {"plotType": "LINE", "legendTemplate": "p99", "timeSeriesQuery": {"timeSeriesFilter": {"filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"orders-api\"", "aggregation": {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_PERCENTILE_99", "crossSeriesReducer": "REDUCE_MEAN"}}}}
            ]
          }
        }
      },
      {
        "yPos": 4, "width": 6, "height": 4,
        "widget": {
          "title": "Container instances (native)",
          "xyChart": {
            "dataSets": [{
              "plotType": "LINE",
              "timeSeriesQuery": {"timeSeriesFilter": {
                "filter": "metric.type=\"run.googleapis.com/container/instance_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"orders-api\"",
                "aggregation": {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_MAX", "crossSeriesReducer": "REDUCE_SUM"}
              }}
            }]
          }
        }
      },
      {
        "xPos": 6, "yPos": 4, "width": 6, "height": 4,
        "widget": {
          "title": "Requests by outcome (log-based)",
          "xyChart": {
            "dataSets": [{
              "plotType": "STACKED_AREA",
              "timeSeriesQuery": {"timeSeriesFilter": {
                "filter": "metric.type=\"logging.googleapis.com/user/orders-api/requests_by_outcome\" resource.type=\"cloud_run_revision\"",
                "aggregation": {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM", "groupByFields": ["metric.label.\"outcome\""]}
              }}
            }]
          }
        }
      },
      {
        "yPos": 8, "width": 6, "height": 4,
        "widget": {
          "title": "Errors by category (log-based)",
          "xyChart": {
            "dataSets": [{
              "plotType": "STACKED_BAR",
              "timeSeriesQuery": {"timeSeriesFilter": {
                "filter": "metric.type=\"logging.googleapis.com/user/orders-api/requests_by_outcome\" resource.type=\"cloud_run_revision\" metric.label.\"outcome\"!=\"success\"",
                "aggregation": {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM", "groupByFields": ["metric.label.\"category\""]}
              }}
            }]
          }
        }
      },
      {
        "xPos": 6, "yPos": 8, "width": 6, "height": 4,
        "widget": {
          "title": "Errors by type (log-based)",
          "xyChart": {
            "dataSets": [{
              "plotType": "STACKED_BAR",
              "timeSeriesQuery": {"timeSeriesFilter": {
                "filter": "metric.type=\"logging.googleapis.com/user/orders-api/errors_by_type\" resource.type=\"cloud_run_revision\"",
                "aggregation": {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_RATE", "crossSeriesReducer": "REDUCE_SUM", "groupByFields": ["metric.label.\"error_type\""]}
              }}
            }]
          }
        }
      },
      {
        "yPos": 12, "width": 6, "height": 4,
        "widget": {
          "title": "App latency p95 by endpoint (log-based)",
          "xyChart": {
            "dataSets": [{
              "plotType": "LINE",
              "timeSeriesQuery": {"timeSeriesFilter": {
                "filter": "metric.type=\"logging.googleapis.com/user/orders-api/request_latency_ms\" resource.type=\"cloud_run_revision\"",
                "aggregation": {"alignmentPeriod": "60s", "perSeriesAligner": "ALIGN_PERCENTILE_95", "crossSeriesReducer": "REDUCE_MEAN", "groupByFields": ["metric.label.\"endpoint\""]}
              }}
            }]
          }
        }
      },
      {
        "xPos": 6, "yPos": 12, "width": 6, "height": 4,
        "widget": {
          "title": "Error rate per minute (Log Analytics SQL)",
          "xyChart": {
            "dataSets": [{
              "plotType": "LINE",
              "timeSeriesQuery": {"opsAnalyticsQuery": {
                "queryHandle": "",
                "sql": "SELECT TIMESTAMP_TRUNC(timestamp, MINUTE) AS minute, COUNTIF(CAST(JSON_VALUE(json_payload.status_code) AS INT64) >= 400) / COUNT(*) AS error_rate FROM `lab-observabilidad-030120.global._Default._Default` WHERE JSON_VALUE(json_payload.message) = 'request_completed' GROUP BY minute ORDER BY minute"
              }}
            }]
          }
        }
      },
      {
        "yPos": 16, "width": 12, "height": 5,
        "widget": {
          "title": "Recent request logs",
          "logsPanel": {
            "filter": "resource.type=\"cloud_run_revision\" resource.labels.service_name=\"orders-api\" jsonPayload.message=\"request_completed\"",
            "resourceNames": ["projects/lab-observabilidad-030120"]
          }
        }
      }
    ]
  }
}
